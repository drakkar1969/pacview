<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!--// PackageItem template //-->
  <template class="PackageItem" parent="GtkBox">
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <property name="margin-top">10</property>
    <property name="margin-bottom">10</property>
    <property name="spacing">12</property>
    <child>
      <object class="GtkImage">
        <property name="icon-name">package-x-generic-symbolic</property>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="hexpand">true</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel" id="name_label">
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
            <style>
              <class name="heading"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">12</property>
            <child>
              <object class="GtkBox">
                <property name="spacing">6</property>
                <child>
                  <object class="TagLabel" id="repository_tag">
                    <property name="tag-type">accent</property>
                  </object>
                </child>
                <child>
                  <object class="TagLabel" id="version_tag">
                    <property name="tag-type">accent</property>
                    <property name="ellipsize">middle</property>
                  </object>
                </child>
                <child>
                  <object class="TagLabel" id="update_tag">
                    <property name="tag-type">warning</property>
                    <property name="text">update</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="TagLabel" id="groups_tag">
                <property name="tag-type">normal</property>
                <property name="ellipsize">end</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="TagLabel" id="status_tag">
        <property name="valign">center</property>
      </object>
    </child>
  </template>
</interface>
