<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!--// PacViewWindow template //-->
  <template class="PacViewWindow" parent="AdwApplicationWindow">
    <property name="default-width">1350</property>
    <property name="default-height">840</property>
    <property name="title">PacView</property>
    <child>
      <object class="AdwBreakpoint" id="info_breakpoint">
        <setter object="info_splitview" property="collapsed">true</setter>
        <setter object="package_view" property="display-mode">no-infopane</setter>
        <setter object="info_pane" property="display-mode">collapsed</setter>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint" id="sidebar_breakpoint">
        <setter object="info_splitview" property="collapsed">true</setter>
        <setter object="sidebar_splitview" property="collapsed">true</setter>
        <setter object="sidebar_button" property="visible">true</setter>
        <setter object="main_menu_button" property="visible">false</setter>
        <setter object="package_view" property="display-mode">no-sidebar</setter>
        <setter object="info_pane" property="display-mode">collapsed</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwOverlaySplitView" id="sidebar_splitview">
        <property name="min-sidebar-width">230</property>
        <property name="max-sidebar-width">230</property>
        <property name="sidebar">
          <object class="AdwToolbarView" id="toolbar_view">
            <child type="top">
              <object class="AdwHeaderBar" id="header_bar">
                <child>
                  <object class="GtkToggleButton" id="sidebar_button">
                    <property name="visible">false</property>
                    <property name="icon-name">sidebar-show-symbolic</property>
                    <property name="tooltip-text">Hide Sidebar</property>
                    <property name="action-name">win.show-sidebar</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkMenuButton" id="main_menu_button">
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="primary">true</property>
                    <property name="tooltip-text">Main Menu</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="margin-start">8</property>
                <property name="margin-end">8</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">12</property>
                <property name="spacing">16</property>
                <child>
                  <object class="AdwSidebar" id="repo_sidebar">
                    <child>
                      <object class="AdwSidebarSection" id="repo_section">
                        <property name="title">Repository</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwSidebar" id="status_sidebar">
                    <child>
                      <object class="AdwSidebarSection" id="status_section">
                        <property name="title">Package Status</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSidebarSection" id="update_section"/>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
        <property name="content">
          <object class="AdwOverlaySplitView" id="info_splitview">
            <property name="sidebar-position">end</property>
            <property name="sidebar-width-fraction">0.5</property>
            <property name="sidebar">
              <object class="InfoPane" id="info_pane">
                <property name="package-view">package_view</property>
              </object>
            </property>
            <property name="content">
              <object class="PackageView" id="package_view">
                <property name="info-pane">info_pane</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
